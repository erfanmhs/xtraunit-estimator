# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — TEMPLATE
#
# This is a SAMPLE file. It is safe to commit and shows which secrets the app
# needs. To actually run the app:
#
#   1. Make a copy of this file in the same folder and name the copy ".env.local"
#   2. Fill in the real values below
#   3. Save. Never share .env.local or commit it to git — it holds your secrets.
#      (.env.local is already ignored by git for you.)
#
# Anything starting with NEXT_PUBLIC_ is sent to the browser and is NOT secret.
# Everything else stays on the server and IS secret.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (your database + logins) ---
# Find these in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Secret server-only key — switches ON the durable job queue: AI runs become
# queued jobs a worker picks up, so they survive restarts/deploys and the app
# can run on more than one server. Find it in Supabase → Settings → API
# ("service_role"). Never expose it to the browser. Without it the app still
# works — jobs just run inside the request's server process as before.
# SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
# Queue knobs (optional): turn the worker off on a host, or change how many
# jobs one instance runs at once (default 2).
# JOB_QUEUE_ENABLED=true
# JOB_WORKER_CONCURRENCY=2

# --- Anthropic Claude (the AI that does the estimating) ---
# Find this at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=your-secret-anthropic-key

# --- AI spend caps (optional — sensible defaults if left out) ---
# Per-user run counts, rolling windows. 0 disables a window.
# AI_DAILY_LIMIT=60
# AI_MONTHLY_LIMIT=600
# Dollar ceiling for ONE run (a Generate / Apply / Suggest prices). The run
# stops at this point, keeps what it drafted, and says so. 0 disables.
# AI_JOB_BUDGET_USD=15
# Burst guard: max AI starts per user in a window of minutes.
# AI_BURST_LIMIT=10
# AI_BURST_WINDOW_MIN=10

# --- Sign-up ---
# "false" closes self-service sign-up: the form hides "Create an account" and
# the server refuses sign-ups even if someone calls it directly. Do this once
# your partners' accounts exist (you add people in Supabase → Auth → Users).
# NEXT_PUBLIC_ALLOW_SIGNUP=true
# While open, sign-ups are rate-limited (per address / total, per hour):
# SIGNUP_LIMIT_PER_IP=5
# SIGNUP_LIMIT_GLOBAL=30

# --- Error tracking: Sentry (optional — the app runs fine without it) ---
# With these UNSET nothing is sent anywhere. To turn it on: create a free
# Sentry project (platform: Next.js), then paste its DSN into BOTH lines below.
# The DSN is a public "send reports here" address, not a secret.
# SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz
#
# Label reports by environment (defaults to NODE_ENV: "production"/"development").
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
#
# Fraction of requests to trace for performance (0–1, default 0.1).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Source-map upload at BUILD time (optional): makes stack traces show real
# file names/lines. Needs a Sentry auth token (Settings → Auth Tokens, scope
# project:releases + org:read). Set on the host that builds (Render), not here.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=xtraunit-estimator
# SENTRY_AUTH_TOKEN=sntrys_secret_token

# --- Logging ---
# Structured JSON log lines go to the server log. debug | info | warn | error.
# LOG_LEVEL=info
